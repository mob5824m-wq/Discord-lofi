# Environment for the lofi systemd unit (/etc/lofi/lofi.env).
#
# This file is created from this example by the package's postinst and is never
# overwritten on upgrade. Keep it mode 0600: it holds your bot token.

# Required. Create the application at https://discord.com/developers/applications
# then Bot -> Reset Token.
#LOFI_TOKEN=your-bot-token-here

# Optional: where config.json, lofi.db and the audio cache live.
# Defaults to /var/lib/lofi via the unit file.
#LOFI_HOME=/var/lib/lofi

# Optional: serve the dashboard somewhere other than 127.0.0.1:8790.
# Read docs/SETUP.md before binding it to anything public - it is an admin panel.
#LOFI_DASHBOARD_HOST=127.0.0.1
#LOFI_DASHBOARD_PORT=8790

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR).
#LOFI_LOG_LEVEL=INFO
